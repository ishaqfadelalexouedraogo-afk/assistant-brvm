# Copie ce fichier en ".env.local" puis remplis les valeurs. Ne publie JAMAIS .env.local sur GitHub.

# Clé de l'API Claude (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude utilisé (par défaut : claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Secret qui signe les sessions : une longue chaîne aléatoire (au moins 32 caractères).
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Codes d'accès des partenaires, au format id:code séparés par des virgules.
# L'id doit exister dans config/partenaires.json.
ACCESS_CODES=demo:DEMO-2026

# Jeton pour consulter la consommation par partenaire (/api/admin/usage). Longue chaîne aléatoire.
ADMIN_TOKEN=

# (Facultatif mais recommandé en production) Base Upstash Redis pour les quotas et la consommation.
# Sans elle, les compteurs sont gardés en mémoire et repartent à zéro à chaque redémarrage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
